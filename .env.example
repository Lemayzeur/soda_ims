# Copy this file to .env and fill in real values.
# Never commit the real .env to version control.

SECRET_KEY=change-me
DATABASE_URL=sqlite:///soda.db

# Leave ZENTRA_TOKEN blank (and DEMO_MODE=true) to run the app fully
# click-through-able with generated demo readings, no hardware required.
ZENTRA_TOKEN=
DEMO_MODE=true

# Gmail App Password, NOT your normal Gmail password.
# https://myaccount.google.com/apppasswords (requires 2-Step Verification on)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

CHECK_FREQUENCY_DAYS=5

# If true, runs an automatic background check every 24h using
# APScheduler. Off by default — turn on once you're ready for it to
# run unattended.
SCHEDULER_ENABLED=false
